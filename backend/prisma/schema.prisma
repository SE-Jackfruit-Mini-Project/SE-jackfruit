generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  HOSPITAL_REQUESTER
  STAFF
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ALLOCATED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model User {
  id                 String              @id @default(cuid())
  fullName           String              @map("full_name") @db.VarChar(120)
  email              String              @unique @db.VarChar(254)
  passwordHash       String              @map("password_hash")
  role               UserRole            @default(DONOR)
  createdAt          DateTime            @default(now()) @map("created_at")
  bloodRequests      BloodRequest[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model BloodRequest {
  id           String        @id @default(cuid())
  requesterId  String        @map("requester_id")
  requester    User          @relation(fields: [requesterId], references: [id])
  hospitalName String        @map("hospital_name") @db.VarChar(150)
  bloodGroup   BloodGroup    @map("blood_group")
  units        Int
  urgency      String        @default("NORMAL") @db.VarChar(20)
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("blood_requests")
}

enum InventoryStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
}

enum InventoryMovementType {
  PURCHASE
  TRANSFER_IN
  ADJUSTMENT
  DONATION
  ALLOCATION
}

// One row per blood group (aggregated quantity). Status is derived from
// availableUnits in the service layer; the CHECK (available_units >= 0)
// constraint is added in the migration.
model Inventory {
  id             String              @id @default(cuid())
  bloodGroup     BloodGroup          @unique @map("blood_group")
  availableUnits Int                 @default(0) @map("available_units")
  status         InventoryStatus     @default(OUT_OF_STOCK)
  updatedAt      DateTime            @updatedAt @map("updated_at")
  movements      InventoryMovement[]

  @@map("inventory")
}

// Append-only history of every change to inventory. delta is positive for
// additions and negative for allocations.
model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String                @map("inventory_id")
  inventory   Inventory             @relation(fields: [inventoryId], references: [id])
  type        InventoryMovementType
  delta       Int
  reason      String?               @db.VarChar(200)
  referenceId String?               @map("reference_id")
  actorId     String?               @map("actor_id")
  actor       User?                 @relation(fields: [actorId], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("sessions")
}


model AppointmentSlot {
  id          String   @id @default(cuid())
  date        String   @db.VarChar(10)
  startTime   String   @map("start_time") @db.VarChar(10)
  endTime     String   @map("end_time") @db.VarChar(10)
  maxCapacity Int      @map("max_capacity")
  bookedCount Int      @default(0) @map("booked_count")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date, startTime, endTime])
  @@map("appointment_slots")
}
