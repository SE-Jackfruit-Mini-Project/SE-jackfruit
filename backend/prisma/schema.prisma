// Prisma Schema Definition for Blood Donation Management System
// Defines database connections, enums, models, relationships, and table mappings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User access roles for Role-Based Access Control (RBAC)
enum UserRole {
  DONOR
  HOSPITAL_REQUESTER
  STAFF
  ADMIN
}

// Operational lifecycle statuses for hospital blood requests
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ALLOCATED
}

// Permitted standardized ABO and Rh blood groups
enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// Donor appointment status lifecycle
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// System user account entity supporting donors, staff, hospital requesters, and admins.
model User {
  id                 String              @id @default(cuid())
  fullName           String              @map("full_name") @db.VarChar(120)
  email              String              @unique @db.VarChar(254)
  passwordHash       String              @map("password_hash")
  role               UserRole            @default(DONOR)
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  gender             String?             @db.VarChar(20)
  bloodGroup         BloodGroup?         @map("blood_group")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  bloodRequests      BloodRequest[]
  inventoryMovements InventoryMovement[]
  appointments       Appointment[]
  donationsAsDonor   Donation[]          @relation("DonationDonor")
  donationsRecorded  Donation[]          @relation("DonationRecorder")

  @@map("users")
}

/// Hospital emergency and standard blood requests submitted for staff review and allocation.
model BloodRequest {
  id           String        @id @default(cuid())
  requesterId  String        @map("requester_id")
  requester    User          @relation(fields: [requesterId], references: [id])
  hospitalName String        @map("hospital_name") @db.VarChar(150)
  bloodGroup   BloodGroup    @map("blood_group")
  units        Int
  urgency      String        @default("NORMAL") @db.VarChar(20)
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("blood_requests")
}

// Derived stock availability level
enum InventoryStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
}

// Movement classification for audit trail logging
enum InventoryMovementType {
  PURCHASE
  TRANSFER_IN
  ADJUSTMENT
  DONATION
  ALLOCATION
}

/// Aggregated inventory stock level per blood group.
// Status is derived from availableUnits in the service layer;
// the CHECK (available_units >= 0) constraint is added in the migration.
model Inventory {
  id             String              @id @default(cuid())
  bloodGroup     BloodGroup          @unique @map("blood_group")
  availableUnits Int                 @default(0) @map("available_units")
  status         InventoryStatus     @default(OUT_OF_STOCK)
  updatedAt      DateTime            @updatedAt @map("updated_at")
  movements      InventoryMovement[]

  @@map("inventory")
}

/// Append-only audit history of every unit delta applied to inventory.
// Delta is positive for additions/donations and negative for allocations.
model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String                @map("inventory_id")
  inventory   Inventory             @relation(fields: [inventoryId], references: [id])
  type        InventoryMovementType
  delta       Int
  reason      String?               @db.VarChar(200)
  referenceId String?               @map("reference_id")
  actorId     String?               @map("actor_id")
  actor       User?                 @relation(fields: [actorId], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

/// HTTP session storage table managed by connect-pg-simple.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("sessions")
}

/// Configurable donor appointment booking time window slots.
model AppointmentSlot {
  id           String        @id @default(cuid())
  date         String        @db.VarChar(10)
  startTime    String        @map("start_time") @db.VarChar(10)
  endTime      String        @map("end_time") @db.VarChar(10)
  maxCapacity  Int           @map("max_capacity")
  bookedCount  Int           @default(0) @map("booked_count")
  isAvailable  Boolean       @default(true) @map("is_available")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]

  @@unique([date, startTime, endTime])
  @@map("appointment_slots")
}

/// Scheduled donation appointment associating a donor with a specific time slot.
model Appointment {
  id        String            @id @default(cuid())
  donorId   String            @map("donor_id")
  donor     User              @relation(fields: [donorId], references: [id])
  slotId    String            @map("slot_id")
  slot      AppointmentSlot   @relation(fields: [slotId], references: [id])
  weightKg  Float?            @map("weight_kg")
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?           @db.VarChar(255)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([donorId, slotId])
  @@map("appointments")
}

/// Completed blood donation event record submitted by medical staff.
model Donation {
  id           String     @id @default(cuid())
  donorId      String     @map("donor_id")
  donor        User       @relation("DonationDonor", fields: [donorId], references: [id])
  recordedById String     @map("recorded_by_id")
  recordedBy   User       @relation("DonationRecorder", fields: [recordedById], references: [id])
  bloodGroup   BloodGroup @map("blood_group")
  units        Int
  donationDate DateTime   @map("donation_date") @db.Date
  accepted     Boolean    @default(false)
  notes        String?    @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([donorId, donationDate])
  @@index([bloodGroup, donationDate])
  @@map("donations")
}
